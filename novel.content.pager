<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>The Awakened — Book One: Before the Beginning</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #111;
  color: #222;
  font-family: Georgia, "Times New Roman", serif;
}

#reader {
  max-width: 850px;
  margin: auto;
  padding: 15px 10px 90px;
}

.page {
  display: none;
  position: relative;
  min-height: calc(100vh - 105px);
  padding: 55px 55px 75px;
  background: #f8f3e8;
  box-shadow: 0 5px 25px rgba(0,0,0,.45);
}

.page.active {
  display: block;
}

.cover {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #18130e;
  color: white;
}

.cover h1 {
  font-size: 4rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  margin: 0;
}

.cover h2 {
  font-weight: normal;
  margin-top: 25px;
}

.cover p {
  margin-top: 45px;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.chapter-title {
  text-align: center;
  margin-bottom: 40px;
}

.chapter-title h2 {
  font-size: 1.9rem;
  line-height: 1.3;
}

.page p {
  font-size: 1.08rem;
  line-height: 1.8;
  margin: 0 0 1.1em;
  text-align: justify;
  text-indent: 1.5em;
}

.page p:first-of-type {
  text-indent: 0;
}

.page-number {
  position: absolute;
  bottom: 25px;
  left: 0;
  right: 0;
  text-align: center;
  color: #666;
}

#navigation {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #181818;
  padding: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  z-index: 100;
}

#navigation button {
  background: #333;
  color: white;
  border: 1px solid #777;
  border-radius: 6px;
  padding: 9px 16px;
  cursor: pointer;
}

#navigation button:disabled {
  opacity: .35;
}

#indicator {
  color: white;
  min-width: 100px;
  text-align: center;
}

@media (max-width: 600px) {

  #reader {
    padding: 5px 5px 80px;
  }

  .page {
    padding: 40px 27px 70px;
  }

  .cover h1 {
    font-size: 2.5rem;
  }

  .cover h2 {
    font-size: 1.05rem;
  }

  .page p {
    font-size: 1rem;
    line-height: 1.7;
    text-align: left;
  }
}
</style>
</head>

<body>

<main id="reader">

  <section class="page cover active">
    <div>
      <h1>THE AWAKENED</h1>
      <h2>Book One: Before the Beginning</h2>
      <p>A Novel</p>
    </div>
    <div class="page-number">1</div>
  </section>

</main>

<nav id="navigation">
  <button id="previous" type="button">← Previous</button>
  <span id="indicator">Loading...</span>
  <button id="next" type="button">Next →</button>
</nav>

<script>

let pages = [];
let currentPage = 0;

async function loadNovel() {

  try {

    const response = await fetch("novel-content.html");

    if (!response.ok) {
      throw new Error("Novel file could not be loaded.");
    }

    const text = await response.text();

    const parser = new DOMParser();

    const documentContent =
      parser.parseFromString(text, "text/html");

    const chapters =
      documentContent.querySelectorAll("article.chapter");

    const reader =
      document.getElementById("reader");

    /*
      Keep the cover.
      Then automatically create pages
      from the CURRENT NOVEL.
    */

    let pageNumber = 1;

    chapters.forEach(function(chapter) {

      const heading =
        chapter.querySelector("h2");

      const paragraphs =
        Array.from(
          chapter.querySelectorAll("p")
        );

      /*
        Seven paragraphs per page.
        This can be changed later.
      */

      const paragraphsPerPage = 7;

      for (
        let start = 0;
        start < paragraphs.length;
        start += paragraphsPerPage
      ) {

        const page =
          document.createElement("section");

        page.className = "page";

        const title =
          start === 0 && heading
          ? `
            <div class="chapter-title">
              <h2>${heading.innerHTML}</h2>
            </div>
          `
          : "";

        const content =
          paragraphs
            .slice(
              start,
              start + paragraphsPerPage
            )
            .map(function(p) {
              return p.outerHTML;
            })
            .join("");

        pageNumber++;

        page.innerHTML = `
          ${title}
          ${content}
          <div class="page-number">
            ${pageNumber}
          </div>
        `;

        reader.appendChild(page);
      }

    });

    pages =
      document.querySelectorAll(".page");

    showPage(0);

  } catch (error) {

    document.getElementById("indicator").textContent =
      "Novel could not load";

    console.error(error);

  }

}


function showPage(number) {

  if (number < 0) {
    number = 0;
  }

  if (number >= pages.length) {
    number = pages.length - 1;
  }

  pages.forEach(function(page, index) {

    page.classList.toggle(
      "active",
      index === number
    );

  });

  currentPage = number;

  document.getElementById("indicator").textContent =
    "Page " +
    (currentPage + 1) +
    " of " +
    pages.length;

  document.getElementById("previous").disabled =
    currentPage === 0;

  document.getElementById("next").disabled =
    currentPage === pages.length - 1;

  window.scrollTo(0, 0);

}


document.getElementById("next").onclick =
  function() {
    showPage(currentPage + 1);
  };


document.getElementById("previous").onclick =
  function() {
    showPage(currentPage - 1);
  };


document.addEventListener(
  "keydown",
  function(event) {

    if (event.key === "ArrowRight") {
      showPage(currentPage + 1);
    }

    if (event.key === "ArrowLeft") {
      showPage(currentPage - 1);
    }

  }
);


loadNovel();

</script>

</body>
</html>