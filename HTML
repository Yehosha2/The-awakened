<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="The Awakened — Book One: Before the Beginning">

  <title>The Awakened — Book One</title>

  <style>

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background:
        radial-gradient(
          circle at top,
          #24344d 0%,
          #111827 45%,
          #05070b 100%
        );
      color: #eee;
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.9;
    }

    /* BOOK HEADER */

    .book-header {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
    }

    .cover {
      width: min(850px, 95%);
      padding: 80px 30px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 18px;

      background:
        linear-gradient(
          rgba(0,0,0,.45),
          rgba(0,0,0,.75)
        );

      box-shadow:
        0 30px 100px rgba(0,0,0,.6);

      position: relative;
      overflow: hidden;
    }

    .cover::before {
      content: "";
      position: absolute;
      inset: 20px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 12px;
      pointer-events: none;
    }

    .cover-symbol {
      font-size: 70px;
      margin-bottom: 20px;
      opacity: .9;
    }

    .cover h1 {
      font-size: clamp(3rem, 9vw, 6rem);
      margin: 0;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .cover h2 {
      font-weight: normal;
      font-size: clamp(1.2rem, 3vw, 2rem);
      margin-top: 15px;
      opacity: .8;
    }

    .cover .author {
      margin-top: 60px;
      font-size: 1rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      opacity: .7;
    }

    .begin-button {
      display: inline-block;
      margin-top: 45px;
      padding: 14px 30px;
      border: 1px solid rgba(255,255,255,.35);
      border-radius: 999px;
      color: white;
      text-decoration: none;
      transition: .25s;
      cursor: pointer;
    }

    .begin-button:hover {
      background: rgba(255,255,255,.1);
      transform: translateY(-2px);
    }

    /* READER */

    .reader {
      width: min(850px, 94%);
      margin: auto;
      padding-bottom: 120px;
    }

    .chapter {
      display: none;

      min-height: 100vh;

      margin-bottom: 40px;
      padding: clamp(35px, 7vw, 80px);

      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,.97),
          rgba(237,233,220,.97)
        );

      color: #191919;

      border-radius: 8px;

      box-shadow:
        0 25px 80px rgba(0,0,0,.45);

      animation: pageIn .45s ease;
    }

    .chapter.active {
      display: block;
    }

    @keyframes pageIn {
      from {
        opacity: 0;
        transform: translateY(15px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .chapter-label {
      text-align: center;
      font-size: .75rem;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: #777;
      margin-bottom: 25px;
    }

    .chapter h2 {
      text-align: center;
      font-size: clamp(1.8rem, 5vw, 3rem);
      letter-spacing: .04em;
      margin-top: 0;
      margin-bottom: 50px;
      line-height: 1.2;
    }

    .chapter p {
      font-size: clamp(1.05rem, 2vw, 1.2rem);
      margin: 0 0 1.5em;
      text-align: justify;
    }

    .chapter p:first-of-type::first-letter {
      float: left;
      font-size: 4.2em;
      line-height: .8;
      padding-right: 8px;
      padding-top: 7px;
      font-weight: bold;
    }

    /* NAVIGATION */

    .reader-controls {
      position: sticky;
      bottom: 20px;
      z-index: 50;

      width: min(850px, 94%);
      margin: auto;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      padding: 12px;

      background: rgba(10,14,22,.9);
      backdrop-filter: blur(12px);

      border: 1px solid rgba(255,255,255,.15);
      border-radius: 999px;

      box-shadow: 0 15px 40px rgba(0,0,0,.4);
    }

    .nav-button {
      border: 0;
      border-radius: 999px;

      padding: 11px 20px;

      background: rgba(255,255,255,.1);
      color: white;

      cursor: pointer;

      font-family: inherit;
      font-size: .9rem;

      transition: .2s;
    }

    .nav-button:hover:not(:disabled) {
      background: rgba(255,255,255,.2);
    }

    .nav-button:disabled {
      opacity: .3;
      cursor: not-allowed;
    }

    .progress {
      flex: 1;
      text-align: center;
      font-size: .8rem;
      color: rgba(255,255,255,.75);
      white-space: nowrap;
    }

    /* FOOTER */

    footer {
      text-align: center;
      padding: 60px 20px;
      color: rgba(255,255,255,.55);
      font-size: .85rem;
    }

    /* MOBILE */

    @media (max-width: 600px) {

      .cover {
        padding: 65px 20px;
      }

      .cover h1 {
        letter-spacing: .03em;
      }

      .chapter {
        padding: 32px 24px;
        border-radius: 4px;
      }

      .chapter p {
        text-align: left;
      }

      .reader-controls {
        bottom: 10px;
      }

      .nav-button {
        padding: 10px 13px;
      }

    }

  </style>
</head>

<body>

  <!-- COVER -->

  <header class="book-header">

    <div class="cover">

      <div class="cover-symbol">✦</div>

      <h1>The Awakened</h1>

      <h2>Book One: Before the Beginning</h2>

      <div class="author">
        A Novel
      </div>

      <a
        href="#reader"
        class="begin-button"
        onclick="startBook()"
      >
        Begin Reading
      </a>

    </div>

  </header>


  <!-- READER -->

  <main
    class="reader"
    id="reader"
  >

    <!-- ==================================================
        
         ==================================================

         Keep your existing Chapter 1–36 <article>
         blocks here.

         Each article must have:

         <article class="chapter">

           <h2>CHAPTER ONE — TITLE</h2>

           <p>...</p>

           <p>...</p>

         </article>

         The JavaScript automatically turns each
         chapter into a readable page.

         ================================================== -->


    <!-- EXAMPLE -->

    <article class="chapter">

      <div class="chapter-label">
        Book One
      </div>

      <h2>
        CHAPTER ONE — BEFORE THE BEGINNING
      </h2>

      <p>
        Before there were kingdoms, before there were
        temples, before scribes placed the first marks
        into wet clay, there was a question.
      </p>

      <p>
        Where did humanity come from?
      </p>

      <p>
        Every civilization eventually asked it.
        Some answered with gods. Some answered with
        ancestors. Some answered with stories carried
        beside rivers and across mountains.
      </p>

      <p>
        But beneath every answer was the same mystery.
      </p>

      <p>
        What happened before the beginning?
      </p>

    </article>


    <!--
      PASTE YOUR EXISTING CHAPTER 2–36 ARTICLES
      BELOW THIS POINT.
    -->


  </main>


  <!-- NAVIGATION -->

  <div class="reader-controls">

    <button
      class="nav-button"
      id="previousButton"
      onclick="previousChapter()"
    >
      ← Previous
    </button>

    <div
      class="progress"
      id="progress"
    >
      Chapter 1
    </div>

    <button
      class="nav-button"
      id="nextButton"
      onclick="nextChapter()"
    >
      Next →
    </button>

  </div>


  <footer>

    <div>
      The Awakened
    </div>

    <div>
      Book One: Before the Beginning
    </div>

  </footer>


  <script>

    const chapters =
      document.querySelectorAll(".chapter");

    let currentChapter = 0;


    function showChapter(index) {

      if (index < 0) {
        index = 0;
      }

      if (index >= chapters.length) {
        index = chapters.length - 1;
      }

      currentChapter = index;


      chapters.forEach((chapter, i) => {

        chapter.classList.toggle(
          "active",
          i === currentChapter
        );

      });


      document.getElementById("progress").textContent =
        "Chapter " +
        (currentChapter + 1) +
        " of " +
        chapters.length;


      document.getElementById("previousButton").disabled =
        currentChapter === 0;


      document.getElementById("nextButton").disabled =
        currentChapter === chapters.length - 1;


      window.scrollTo({
        top: document.getElementById("reader").offsetTop - 20,
        behavior: "smooth"
      });

    }


    function nextChapter() {

      if (currentChapter < chapters.length - 1) {

        showChapter(currentChapter + 1);

      }

    }


    function previousChapter() {

      if (currentChapter > 0) {

        showChapter(currentChapter - 1);

      }

    }


    function startBook() {

      showChapter(0);

    }


    /* KEYBOARD NAVIGATION */

    document.addEventListener(
      "keydown",
      function(event) {

        if (event.key === "ArrowRight") {

          nextChapter();

        }

        if (event.key === "ArrowLeft") {

          previousChapter();

        }

      }
    );


    /* START ON FIRST CHAPTER */

    showChapter(0);

  </script>

</body>
</html>
