      position: relative;
      overflow: hidden;
    }

    .cover::before {
      content: "";
      position: absolute;
      inset: 20px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 12px;
      pointer-events: none;
    }

    .cover-symbol {
      font-size: 70px;
      margin-bottom: 20px;
      opacity: .9;
