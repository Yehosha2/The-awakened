<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>The Awakened — Book One: Before the Beginning</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #111;
      font-family: Georgia, "Times New Roman", serif;
      color: #222;
    }

    #reader {
      max-width: 850px;
      margin: auto;
      padding: 20px 10px 100px;
    }

    .page {
      display: none;
      position: relative;
      min-height: 850px;
      padding: 70px 65px 90px;
      background: #f8f3e8;
      box-shadow: 0 5px 25px rgba(0,0,0,.5);
    }

    .page.active {
      display: block;
    }

    /* COVER */

    .cover {
      min-height: 850px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: #18130e;
      color: white;
    }

    .cover h1 {
      font-size: 4rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      margin: 0;
    }

    .cover h2 {
      font-weight: normal;
      margin-top: 25px;
    }

    .cover p {
      margin-top: 50px;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    /* BOOK TEXT */

    .chapter {
      text-align: center;
      margin-bottom: 55px;
    }

    .chapter h2 {
      font-size: 2rem;
      margin-top: 15px;
    }

    .chapter small {
      text-transform: uppercase;
      letter-spacing: .2em;
    }

    .page p {
      font-size: 1.1rem;
      line-height: 1.8;
      margin: 0 0 1.2em;
      text-align: justify;
      text-indent: 1.5em;
    }

    .page p:first-of-type {
      text-indent: 0;
    }

    .page-number {
      position: absolute;
      bottom: 30px;
      left: 0;
      right: 0;
      text-align: center;
      color: #666;
    }

    /* NAVIGATION */

    #navigation {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #181818;
      padding: 12px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
      z-index: 1000;
    }

    #navigation button {
      background: #333;
      color: white;
      border: 1px solid #777;
      border-radius: 6px;
      padding: 10px 18px;
      font-size: 15px;
      cursor: pointer;
    }

    #navigation button:disabled {
      opacity: .35;
    }

    #indicator {
      color: white;
      min-width: 90px;
      text-align: center;
    }

    @media (max-width: 600px) {

      #reader {
        padding: 5px 5px 85px;
      }

      .page {
        min-height: calc(100vh - 90px);
        padding: 45px 28px 75px;
      }

      .cover {
        min-height: calc(100vh - 90px);
      }

      .cover h1 {
        font-size: 2.6rem;
      }

      .cover h2 {
        font-size: 1.1rem;
      }

      .page p {
        font-size: 1rem;
        line-height: 1.7;
        text-align: left;
      }

      #navigation {
        gap: 7px;
      }

      #navigation button {
        padding: 9px 12px;
        font-size: 13px;
      }
    }
  </style>
</head>

<body>

  <main id="reader">

    <!-- PAGE 1 -->

    <section class="page cover active">

      <div>

        <h1>THE AWAKENED</h1>

        <h2>Book One: Before the Beginning</h2>

        <p>A Novel</p>

      </div>

      <div class="page-number">1</div>

    </section>


    <!-- PAGE 2 -->

    <section class="page">

      <div class="chapter">

        <small>Book One</small>

        <h2>Before the Beginning</h2>

      </div>

      <p>
        Before there were kingdoms, there were rivers.
      </p>

      <p>
        Before there were temples, there were fires.
      </p>

      <p>
        Before men carved the names of their gods into stone,
        they looked into the darkness above them and wondered
        where the darkness ended.
      </p>

      <p>
        And before anyone knew the word <em>history</em>,
        someone remembered.
      </p>

      <div class="page-number">2</div>

    </section>


    <!-- PAGE 3 -->

    <section class="page">

      <div class="chapter">

        <small>Prologue</small>

        <h2>Before the Beginning</h2>

      </div>

      <p>
        The old scribe dipped his reed into the dark ink.
      </p>

      <p>
        Outside, the night pressed against the walls of the
        ancient city.
      </p>

      <p>
        He listened.
      </p>

      <p>
        The wind moved across the roof like a whisper from
        another age.
      </p>

      <p>
        Then he began to write.
      </p>

      <div class="page-number">3</div>

    </section>


    <!-- PAGE 4 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter One</small>

        <h2>The First Memory</h2>

      </div>

      <p>
        The first memory did not begin with a face.
      </p>

      <p>
        It began with light.
      </p>

      <p>
        A light so ancient that no human language had yet
        found a name for it.
      </p>

      <p>
        He opened his eyes.
      </p>

      <p>
        At first there was nothing but darkness.
      </p>

      <p>
        Then came the sound of water.
      </p>

      <div class="page-number">4</div>

    </section>


    <!-- PAGE 5 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Two</small>

        <h2>The Voice</h2>

      </div>

      <p>
        The voice did not come from the sky.
      </p>

      <p>
        It came from somewhere deeper.
      </p>

      <p>
        He stood completely still.
      </p>

      <p>
        The world around him seemed to hold its breath.
      </p>

      <p>
        Then the voice spoke again.
      </p>

      <p>
        It called him by a name he had never heard before.
      </p>

      <div class="page-number">5</div>

    </section>


    <!-- PAGE 6 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Three</small>

        <h2>The Awakening</h2>

      </div>

      <p>
        The earth beneath him trembled.
      </p>

      <p>
        He looked toward the horizon.
      </p>

      <p>
        The darkness was beginning to disappear.
      </p>

      <p>
        Something had changed.
      </p>

      <p>
        He knew then that whatever had been asleep was no
        longer sleeping.
      </p>

      <p>
        Neither was he.
      </p>

      <div class="page-number">6</div>

    </section>


    <!-- PAGE 7 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Four</small>

        <h2>The Garden</h2>

      </div>

      <p>
        Beyond the hills was a place untouched by the wars
        that would someday divide the nations.
      </p>

      <p>
        Water flowed through the center of it.
      </p>

      <p>
        Trees covered the land.
      </p>

      <p>
        And in the middle of the garden stood something that
        had no name.
      </p>

      <p>
        He stepped forward.
      </p>

      <div class="page-number">7</div>

    </section>


    <!-- PAGE 8 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Five</small>

        <h2>The Son</h2>

      </div>

      <p>
        He had heard the stories.
      </p>

      <p>
        Stories of a coming son.
      </p>

      <p>
        Stories of a light that would enter the world and
        challenge the darkness.
      </p>

      <p>
        But stories were easy to believe when they belonged
        to someone else.
      </p>

      <p>
        Now the promise was standing before him.
      </p>

      <div class="page-number">8</div>

    </section>


    <!-- PAGE 9 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Six</small>

        <h2>The Road</h2>

      </div>

      <p>
        The road stretched toward the distant mountains.
      </p>

      <p>
        He knew there would be no turning back.
      </p>

      <p>
        Every step carried him farther from the life he had
        once known.
      </p>

      <p>
        Yet every step also brought him closer to the truth.
      </p>

      <div class="page-number">9</div>

    </section>


    <!-- PAGE 10 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Seven</small>

        <h2>The Sign</h2>

      </div>

      <p>
        At sunrise, the sign appeared.
      </p>

      <p>
        No one understood what it meant.
      </p>

      <p>
        But he did.
      </p>

      <p>
        The ancient memory was returning.
      </p>

      <div class="page-number">10</div>

    </section>


    <!-- PAGE 11 -->

    <section class="page">

      <div class="chapter">

        <small>Chapter Eight</small>

        <h2>The Kingdom</h2>

      </div>

      <p>
        The kingdom was not where they expected it to be.
      </p>

      <p>
        It was not built from stone.
      </p>

      <p>
        It was not defended by armies.
      </p>

      <p>
        It began inside the hearts of those who were willing
        to awaken.
      </p>

      <p>
        And the journey had only begun.
      </p>

      <div class="page-number">11</div>

    </section>

  </main>


  <!-- NAVIGATION -->

  <nav id="navigation">

    <button
      id="previous"
      type="button"
      onclick="previousPage()">
      ← Previous
    </button>

    <span id="indicator">
      Page 1 of 11
    </span>

    <button
      id="next"
      type="button"
      onclick="nextPage()">
      Next →
    </button>

  </nav>


  <!-- PAGE CONTROLS -->

  <script>

    const pages = document.querySelectorAll(".page");

    let currentPage = 0;


    function showPage(number) {

      if (number < 0) {
        number = 0;
      }

      if (number >= pages.length) {
        number = pages.length - 1;
      }

      pages.forEach(function(page, index) {

        page.classList.toggle(
          "active",
          index === number
        );

      });

      currentPage = number;

      document.getElementById("indicator").textContent =
        "Page " + (currentPage + 1) +
        " of " + pages.length;

      document.getElementById("previous").disabled =
        currentPage === 0;

      document.getElementById("next").disabled =
        currentPage === pages.length - 1;

      window.scrollTo(0, 0);
    }


    function nextPage() {

      showPage(currentPage + 1);

    }


    function previousPage() {

      showPage(currentPage - 1);

    }


    document.addEventListener("keydown", function(event) {

      if (event.key === "ArrowRight") {
        nextPage();
      }

      if (event.key === "ArrowLeft") {
        previousPage();
      }

    });


    showPage(0);

  </script>

</body>
</html>